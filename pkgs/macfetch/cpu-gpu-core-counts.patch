diff --git a/src/macfetch/utils/iokit.rs b/src/macfetch/utils/iokit.rs
new file mode 100644
index 0000000..d1af9b2
--- /dev/null
+++ b/src/macfetch/utils/iokit.rs
@@ -0,0 +1,144 @@
+use std::ffi::{c_char, c_void, CString};
+use std::ptr;
+
+/// An `io_object_t` / `io_service_t`. Zero means "no object".
+type IoObject = u32;
+
+/// An opaque Core Foundation reference (`CFTypeRef` and friends).
+type CfTypeRef = *const c_void;
+
+/// `kCFNumberSInt32Type`.
+const CF_NUMBER_SINT32_TYPE: i32 = 3;
+
+/// `kCFStringEncodingUTF8`.
+const CF_STRING_ENCODING_UTF8: u32 = 0x0800_0100;
+
+#[link(name = "IOKit", kind = "framework")]
+extern "C" {
+    fn IOServiceMatching(name: *const c_char) -> CfTypeRef;
+    fn IOServiceGetMatchingService(main_port: u32, matching: CfTypeRef) -> IoObject;
+    fn IORegistryEntryCreateCFProperty(
+        entry: IoObject,
+        key: CfTypeRef,
+        allocator: CfTypeRef,
+        options: u32,
+    ) -> CfTypeRef;
+    fn IOObjectRelease(object: IoObject) -> i32;
+}
+
+#[link(name = "CoreFoundation", kind = "framework")]
+extern "C" {
+    fn CFStringCreateWithCString(
+        allocator: CfTypeRef,
+        cstr: *const c_char,
+        encoding: u32,
+    ) -> CfTypeRef;
+    fn CFGetTypeID(cf: CfTypeRef) -> usize;
+    fn CFNumberGetTypeID() -> usize;
+    fn CFNumberGetValue(number: CfTypeRef, number_type: i32, value: *mut c_void) -> u8;
+    fn CFRelease(cf: CfTypeRef);
+}
+
+/// Reads an integer property from the first IORegistry entry matching a class.
+///
+/// Returns `None` when the class is absent (which is the ordinary case for
+/// Apple Silicon specific classes on an Intel Mac), when the entry carries no
+/// such property, or when the property is not a number.
+pub fn registry_property_i32(class_name: &str, property: &str) -> Option<i32> {
+    let class_name = CString::new(class_name).ok()?;
+    let property = CString::new(property).ok()?;
+
+    // SAFETY: IOServiceMatching copies the class name out of the pointer, which
+    // stays valid for the call. The dictionary it returns is consumed by
+    // IOServiceGetMatchingService, so it must not be released here.
+    let service = unsafe {
+        let matching = IOServiceMatching(class_name.as_ptr());
+        if matching.is_null() {
+            return None;
+        }
+
+        // A main port of 0 is MACH_PORT_NULL, which selects the default port.
+        // That avoids naming kIOMasterPortDefault, renamed kIOMainPortDefault
+        // in macOS 12.
+        IOServiceGetMatchingService(0, matching)
+    };
+
+    if service == 0 {
+        return None;
+    }
+
+    // SAFETY: service is a live io_service_t, released below on every path. The
+    // CFString and the property both come from "Create" calls, so we own them
+    // and release them here too.
+    unsafe {
+        let key =
+            CFStringCreateWithCString(ptr::null(), property.as_ptr(), CF_STRING_ENCODING_UTF8);
+
+        let value = if key.is_null() {
+            None
+        } else {
+            let property = IORegistryEntryCreateCFProperty(service, key, ptr::null(), 0);
+            let value = read_i32(property);
+
+            if !property.is_null() {
+                CFRelease(property);
+            }
+            CFRelease(key);
+
+            value
+        };
+
+        IOObjectRelease(service);
+
+        value
+    }
+}
+
+/// Unwraps a `CFNumberRef` into an `i32`.
+///
+/// # Safety
+///
+/// `property` must be null or a valid, owned Core Foundation object.
+unsafe fn read_i32(property: CfTypeRef) -> Option<i32> {
+    // CFNumberGetValue is undefined on anything that is not a CFNumber, so the
+    // type has to be checked rather than assumed.
+    if property.is_null() || CFGetTypeID(property) != CFNumberGetTypeID() {
+        return None;
+    }
+
+    let mut value: i32 = 0;
+    let read = CFNumberGetValue(
+        property,
+        CF_NUMBER_SINT32_TYPE,
+        &mut value as *mut i32 as *mut c_void,
+    );
+
+    match read {
+        0 => None,
+        _ => Some(value),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_registry_property_unknown_class() {
+        let result = registry_property_i32("NoSuchIOKitClass", "gpu-core-count");
+        assert!(result.is_none());
+    }
+
+    #[test]
+    fn test_registry_property_unknown_property() {
+        // IOResources exists on every Mac, but carries no such property
+        let result = registry_property_i32("IOResources", "no-such-property");
+        assert!(result.is_none());
+    }
+
+    #[test]
+    fn test_registry_property_rejects_interior_nul() {
+        let result = registry_property_i32("IOResources\0", "gpu-core-count");
+        assert!(result.is_none());
+    }
+}

+/// Physical core count per performance level, fastest tier first.
+///
+/// The tier names are read rather than assumed: they are not always the
+/// "Performance"/"Efficiency" pair, an M5 Pro reports "Super" and "Performance".
+fn cpu_perflevels() -> Vec<(String, u32)> {
+    let levels = ctl::get_ctl_number("hw.nperflevels").unwrap_or(0);
+
+    (0..levels)
+        .filter_map(|level| {
+            let name = ctl::get_ctl_info(&format!("hw.perflevel{}.name", level))
+                .and_then(|ctl| ctl.value_string().ok())?;
+            let cores = ctl::get_ctl_number(&format!("hw.perflevel{}.physicalcpu", level))?;
+
+            Some((name, cores))
+        })
+        .collect()
+}
+

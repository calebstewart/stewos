+/// Reads a numeric sysctl.
+///
+/// Every integer `CtlValue` renders as a plain decimal string, so parsing that
+/// covers the `hw.*` counters without caring about their underlying width.
+pub fn get_ctl_number(key: &str) -> Option<u32> {
+    get_ctl_info(key)
+        .and_then(|ctl| ctl.value_string().ok())
+        .and_then(|value| value.parse().ok())
+}
